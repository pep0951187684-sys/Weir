task.spawn(function()
    for i = 1, 100 do
        LoadStatus.Text = "กำลังดาวน์โหลด... " .. i .. "%"
        T:Create(BarFill, TweenInfo.new(0.025, Enum.EasingStyle.Linear), {Size = UDim2.new(i / 100, 0, 1, 0)}):Play()
        task.wait(0.025)
    end
    
    LoadStatus.Text = "ดาวน์โหลดเสร็จสิ้น!"
    task.wait(0.4)
    
    T:Create(Blur, TweenInfo.new(0.5), {Size = 0}):Play()
    T:Create(LoadBackground, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    
    for _, desc in ipairs(LoadBackground:GetDescendants()) do
        if desc:IsA("TextLabel") then
            T:Create(desc, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
        elseif desc:IsA("ImageLabel") then
            T:Create(desc, TweenInfo.new(0.5), {ImageTransparency = 1}):Play()
        elseif desc:IsA("Frame") then
            T:Create(desc, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
        elseif desc:IsA("UIStroke") then
            T:Create(desc, TweenInfo.new(0.5), {Transparency = 1}):Play()
        end
    end
    
    task.wait(0.5)
    Blur:Destroy()
    LoadBackground:Destroy()
    M.Visible = true
end)
