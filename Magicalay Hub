-- Main Loop (Noclip, Speed, Jump, ShiftLock Rotation)
R.Stepped:Connect(function()
    if isUnloaded then return end
    local char = LP.Character
    if char then
        if noclip then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
        local hum = char:FindFirstChild("Humanoid")
        if hum then 
            if spd then hum.WalkSpeed = spdVal end 
            if jmp then hum.JumpPower = jmpVal end 
        end
        
        -- ShiftLock Direction Lock
        if shiftLockFeatureOn and isShiftLockActive and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            local _, y = Cam.CFrame:ToEulerAnglesYXZ()
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, y, 0)
        end
    end
end)
