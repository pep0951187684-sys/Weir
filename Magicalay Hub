local espOn, espC = false, {}
local function remESP(p) if espC[p] then if espC[p].H then espC[p].H:Destroy() end if espC[p].B then espC[p].B:Destroy() end espC[p] = nil end end
local function addESP(p)
    if p == LP then return end
    local function sc(c)
        remESP(p) if not espOn then return end
        task.spawn(function()
            local hd = c:WaitForChild("Head", 3) if not hd or not c:FindFirstChild("HumanoidRootPart") then return end
            espC[p] = {
                H = N("Highlight", c, {Name = "ESP_H", Adornee = c, FillColor = Color3.fromRGB(130, 70, 220), OutlineColor = Color3.new(1,1,1), FillTransparency = 0.5}),
                B = N("BillboardGui", hd, {Name = "ESP_B", AlwaysOnTop = true, Size = UDim2.new(0, 200, 0, 50), StudsOffset = Vector3.new(0, 2.5, 0)})
            }
            N("TextLabel", espC[p].B, {Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Text = p.DisplayName.." (@"..p.Name..")", TextColor3 = Color3.new(1,1,1), TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(130, 70, 220), Font = Enum.Font.GothamBold, TextSize = 13})
        end)
    end
    if p.Character then sc(p.Character) end p.CharacterAdded:Connect(sc)
end

