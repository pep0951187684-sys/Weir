-- Target System (ค้นหาชื่อย่อได้)
local selP = ""
local TargetFrame = N("Frame", P4, {Size = UDim2.new(1,0,0,140), BackgroundColor3 = Color3.fromRGB(38,26,65)}) C(TargetFrame)
local TargetStatus = N("TextLabel", TargetFrame, {Size = UDim2.new(1,-16,0,20), Position = UDim2.new(0,8,0,6), BackgroundTransparency = 1, Font = Enum.Font.GothamSemibold, Text = "🎯 ผู้เล่นที่เลือก: ยังไม่ได้เลือก", TextColor3 = Color3.fromRGB(200,200,200), TextSize = 11, TextXAlignment = 0})
local SearchBox = N("TextBox", TargetFrame, {Size = UDim2.new(1,-16,0,28), Position = UDim2.new(0,8,0,28), BackgroundColor3 = Color3.fromRGB(28,18,48), Font = Enum.Font.Gotham, PlaceholderText = "🔍 พิมพ์ชื่อย่อผู้เล่น...", Text = "", TextColor3 = Color3.new(1,1,1), TextSize = 11}) C(SearchBox)

SearchBox.Changed:Connect(function(prop)
    if prop == "Text" then
        local q = SearchBox.Text:lower()
        if q == "" then 
            selP = "" 
            TargetStatus.Text = "🎯 ผู้เล่นที่เลือก: ยังไม่ได้เลือก"
            return 
        end
        local found = false
        for _, p in ipairs(P:GetPlayers()) do
            if p ~= LP and (p.Name:lower():find(q, 1, true) or p.DisplayName:lower():find(q, 1, true)) then 
                selP = p.Name 
                TargetStatus.Text = "🎯 เจอแล้ว: " .. p.DisplayName .. " (@" .. p.Name .. ")"
                found = true
                break 
            end
        end
        if not found then
            selP = ""
            TargetStatus.Text = "❌ ไม่พบผู้เล่นชื่อนี้"
        end
    end
end)

local function getT() return selP ~= "" and P:FindFirstChild(selP) end
