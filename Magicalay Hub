local function toggleSlider(parent, title, ph, min, max, y, cb)
    local r = N("Frame", parent, {Size = UDim2.new(1,-24,0,45), Position = UDim2.new(0,12,0,y), BackgroundColor3 = Color3.fromRGB(28, 18, 48), BackgroundTransparency = 0.3}) C(r, UDim.new(0, 6))
    N("TextLabel", r, {Size = UDim2.new(0.25,0,1,0), Position = UDim2.new(0,10,0,0), BackgroundTransparency = 1, Font = Enum.Font.GothamSemibold, Text = title, TextColor3 = Color3.fromRGB(220,220,220), TextSize = 12, TextXAlignment = 0})
    local val = ph and tonumber(ph:match("^(%d+)")) or 0
    if ph then
        local sb = N("Frame", r, {Size = UDim2.new(0, 120, 0, 6), Position = UDim2.new(1, -235, 0.5, -3), BackgroundColor3 = Color3.fromRGB(48,32,85), BackgroundTransparency = 0.2}) C(sb, UDim.new(1, 0))
        local sf = N("Frame", sb, {Size = UDim2.new((val - min)/(max - min), 0, 1, 0), BackgroundColor3 = Color3.fromRGB(130, 70, 220)}) C(sf, UDim.new(1, 0))
        local kn = N("Frame", sb, {Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new((val - min)/(max - min), -8, 0.5, -8), BackgroundColor3 = Color3.new(1,1,1), ZIndex = 5}) C(kn, UDim.new(1, 0)) S(kn, Color3.fromRGB(130, 70, 220), 2)
        local sbtn = N("TextButton", sb, {Size = UDim2.new(1, 16, 1, 16), Position = UDim2.new(0, -8, 0, -8), BackgroundTransparency = 1, Text = "", ZIndex = 6})
        local tb = N("TextBox", r, {Size = UDim2.new(0,45,0,26), Position = UDim2.new(1,-105,0.5,-13), BackgroundColor3 = Color3.fromRGB(48,32,85), BackgroundTransparency = 0.2, Font = Enum.Font.Gotham, PlaceholderText = ph, Text = tostring(val), TextColor3 = Color3.new(1,1,1), TextSize = 11}) C(tb, UDim.new(0, 6))
        
        local function upd(n, inp)
            val = math.clamp(n, min, max) local pct = (val - min)/(max - min)
            if not inp then tb.Text = tostring(val) end sf.Size, kn.Position = UDim2.new(pct, 0, 1, 0), UDim2.new(pct, -8, 0.5, -8)
            if title:match("ความเร็ว") then spdVal = val elseif title:match("กระโดด") then jmpVal = val end
        end
        local drag = false
        sbtn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = true end end)
        sbtn.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end end)
        U.InputChanged:Connect(function(i) if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(math.floor(min + (max - min) * math.clamp((i.Position.X - sb.AbsolutePosition.X) / sb.AbsoluteSize.X, 0, 1)), false) end end)
        tb.FocusLost:Connect(function() local n = tonumber(tb.Text) if n then upd(n, true) end end)
    end
    local tr = N("TextButton", r, {Size = UDim2.new(0,44,0,26), Position = UDim2.new(1,-50,0.5,-13), BackgroundColor3 = Color3.fromRGB(55,40,85), BackgroundTransparency = 0.2, Text = "", AutoButtonColor = false}) C(tr, UDim.new(1, 0))
    local tk = N("Frame", tr, {Size = UDim2.new(0,22,0,22), Position = UDim2.new(0,2,0.5,-11), BackgroundColor3 = Color3.new(1,1,1)}) C(tk, UDim.new(1, 0))
    local st = false
    tr.MouseButton1Click:Connect(function()
        st = not st
        T:Create(tk, TweenInfo.new(0.2), {Position = st and UDim2.new(1,-24,0.5,-11) or UDim2.new(0,2,0.5,-11)}):Play()
        T:Create(tr, TweenInfo.new(0.2), {BackgroundColor3 = st and Color3.fromRGB(52,199,89) or Color3.fromRGB(55,40,85), BackgroundTransparency = st and 0 or 0.2}):Play()
        cb(st, val)
    end)
end

